# Discord bot and application
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URL=http://127.0.0.1:8080/auth/discord/callback

# Register commands immediately in one development guild. Omit for global commands.
DISCORD_DEV_GUILD_ID=

# Dashboard
DASHBOARD_BIND=0.0.0.0:8080
DASHBOARD_PUBLIC_URL=http://127.0.0.1:8080
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800

# Storage. If omitted, an in-memory store is used for local development.
# In full Docker Compose deployments, use host 'postgres':
#   DATABASE_URL=postgres://rusty_discord_bot:rusty_discord_bot@postgres:5432/rusty_discord_bot
# When running `cargo run` locally on the host with `compose.override.yaml`:
#   DATABASE_URL=postgres://rusty_discord_bot:rusty_discord_bot@127.0.0.1:5432/rusty_discord_bot
DATABASE_URL=postgres://rusty_discord_bot:rusty_discord_bot@postgres:5432/rusty_discord_bot

# Ticket transcripts encryption at rest (AEAD AES-256-GCM).
# Required when DATABASE_URL is set (unless TICKET_TRANSCRIPTS_DISABLED=true).
# Generate a random 32-byte (64 hex characters) key using: `openssl rand -hex 32`
# Paste the generated value here. DO NOT commit production keys to git!
TRANSCRIPT_ENCRYPTION_KEY=
TRANSCRIPT_ACTIVE_KEY_ID=v1
# Keyring for zero-downtime key rotation (comma-separated or JSON):
# TRANSCRIPT_KEYRING=v1:<hex64>,v2:<hex64>
# Or JSON: {"v1":"<hex64>","v2":"<hex64>"}
# Optional: explicitly disable transcript storage to run PostgreSQL without transcripts:
# TICKET_TRANSCRIPTS_DISABLED=false

# Third-party integration credentials encryption at rest (AEAD AES-256-GCM).
# Required when DATABASE_URL is set (unless INTEGRATION_CREDENTIALS_DISABLED=true).
# Distinct cryptographic domain keyring from TRANSCRIPT_ENCRYPTION_KEY.
# Protects Telegram bridge secret tokens, incoming webhook subscription secrets,
# OAuth provider access/refresh tokens (GitHub, GitLab, VK, etc.).
# Generate a distinct random 32-byte (64 hex characters) key: `openssl rand -hex 32`
# During upgrade of existing deployments, add this key to your .env BEFORE updating the container image.
INTEGRATION_CREDENTIAL_KEY=
INTEGRATION_CREDENTIAL_ACTIVE_KEY_ID=v1
# Keyring for zero-downtime key rotation (comma-separated or JSON):
# INTEGRATION_CREDENTIAL_KEYRING=v1:<hex64>,v2:<hex64>
# Or JSON: {"v1":"<hex64>","v2":"<hex64>"}
# Optional: explicitly disable integration credentials storage encryption if integrations are unused:
# INTEGRATION_CREDENTIALS_DISABLED=false

# Lua sandbox
SCRIPTS_DIR=scripts
LUA_MEMORY_LIMIT_BYTES=8388608
LUA_INSTRUCTION_LIMIT=500000
LUA_HOOK_GRANULARITY=1000

# Comma-separated allowlist used when /music receives a URL.
MUSIC_ALLOWED_HOSTS=youtube.com,www.youtube.com,m.youtube.com,youtu.be,soundcloud.com,www.soundcloud.com,bandcamp.com

# Metrics & Observability security
# Protects /metrics endpoint. When set, scrapers must provide `Authorization: Bearer <METRICS_TOKEN>`.
# If unset, local loopback connections (127.0.0.1, ::1) or IPs in METRICS_ALLOWED_IPS are allowed.
# METRICS_TOKEN=
# Comma-separated list of trusted scraper IP addresses allowed to access /metrics:
# METRICS_ALLOWED_IPS=127.0.0.1,::1
